# Copy values into the OpenMetadata service environment. Never commit the real secret.
INTEGRATE_SSO_ENABLED=true
INTEGRATE_SSO_ISSUER=https://integrate.example.hospital
# Optional server-only origin; defaults to issuer. For a device-certificate
# gateway, use the authenticated cluster backchannel configured by hospital IT.
INTEGRATE_SSO_BACKCHANNEL_ORIGIN=https://integrate.example.hospital
INTEGRATE_SSO_TARGET_ORIGIN=https://metadata.example.hospital
INTEGRATE_SSO_CLIENT_ID=CHANGE_ME_TO_THE_REGISTERED_CLIENT_ID
INTEGRATE_SSO_CLIENT_SECRET=CHANGE_ME_TO_A_SHARED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
INTEGRATE_SSO_PORTAL_PATH=/s/portal
INTEGRATE_SSO_EMAIL_DOMAIN=integrate.invalid
INTEGRATE_SSO_ALLOW_HTTP_TEST=false

# Keep native internal JWT verification configured. Human password endpoints
# are disabled by INTEGRATE_SSO_ENABLED; these are not employee login options.
AUTHENTICATION_PROVIDER=basic
AUTHENTICATION_CLIENT_TYPE=public
AUTHENTICATION_ENABLE_SELF_SIGNUP=false
FORCE_SECURE_SESSION_COOKIE=true
